VITE_TICKET_TEMPLATE_WIDTH=1000
VITE_TICKET_TEMPLATE_HEIGHT=500
VITE_TICKET_TEMPLATE_MAX_SIZE_MB=10

# Referencias de despliegue para la terminal local.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
TF_VAR_app_secret_arn=

